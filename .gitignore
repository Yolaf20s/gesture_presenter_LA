# Python environments
venv/
.venv/
env/
ENV/

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Packaging / build outputs
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Local config and secrets
.env
.env.*
!.env.example

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
*.part
tmp/
temp/

# Downloaded MediaPipe Tasks bundles
models/mediapipe/*.task
models/mediapipe/*.task.part

# Locally generated training/model artifacts.
# Already tracked files stay tracked; this only prevents new local outputs from
# being added accidentally.
data/dataset/**/*.npy
models/*.npz
!models/mediapipe/.gitkeep
